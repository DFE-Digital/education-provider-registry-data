{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "s189d01-eprdat-development-adf"
		},
		"AzureDataLakeStorage1_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'AzureDataLakeStorage1'"
		},
		"AzureDataLakeStorage1_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://s189d01eprdatdevelopment.dfs.core.windows.net/"
		},
		"s189d01-eprdat-development-adf-standard-storage-pe_properties_privateLinkResourceId": {
			"type": "string",
			"defaultValue": "/subscriptions/5c83eb53-a94f-4778-b258-1f33efe49655/resourceGroups/s189d01-eprdat-ts-rg/providers/Microsoft.Storage/storageAccounts/s189d01eprdatdevelopment"
		},
		"s189d01-eprdat-development-adf-standard-storage-pe_properties_groupId": {
			"type": "string",
			"defaultValue": "blob"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "s189d01-eprdat-development-adf_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"AzureDataLakeStorage1_accountKey": {
						"value": "[parameters('AzureDataLakeStorage1_accountKey')]"
					},
					"AzureDataLakeStorage1_properties_typeProperties_url": {
						"value": "[parameters('AzureDataLakeStorage1_properties_typeProperties_url')]"
					},
					"s189d01-eprdat-development-adf-standard-storage-pe_properties_privateLinkResourceId": {
						"value": "[parameters('s189d01-eprdat-development-adf-standard-storage-pe_properties_privateLinkResourceId')]"
					},
					"s189d01-eprdat-development-adf-standard-storage-pe_properties_groupId": {
						"value": "[parameters('s189d01-eprdat-development-adf-standard-storage-pe_properties_groupId')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}